# Offline demo needs no configuration. Real LLM mode requires a key and model.
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=https://api.openai.com/v1
# auto, responses (OpenAI native), or chat_completions (compatible providers)
LLM_API_STYLE=auto
LLM_TIMEOUT=45
LLM_MAX_RETRIES=2
AGENT_MAX_STEPS=12
AGENT_MAX_TOOL_CALLS=32
AGENT_MEMORY_TURNS=6
AGENT_TEST_TIMEOUT=10
# Directory review limits; oversized or unread files are listed explicitly.
AGENT_PROJECT_MAX_FILES=40
AGENT_PROJECT_MAX_CHARS=500000
